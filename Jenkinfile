node
{
 // /var/lib/jenkins/tools/hudson.tasks.Maven_MavenInstallation/maven-3.9.16/bin
 def  mavenHome=tool name: "maven-3.9.16"
 stage('git checkout')
 {
  git branch: 'main', url: 'https://github.com/mummadi-devops/maven-webapplication-project-kkfunda.git'
 }
  stage('compile')
 {
  sh "${mavenHome}/bin/mvn compile"
 }
  stage('Build')
 {
  sh "${mavenHome}/bin/mvn clean package"
 }
 stage('SQ REPORT')
 {
  sh "${mavenHome}/bin/mvn sonar:sonar"
 }
 stage('Deploy Nexus Artifact')
 {
  sh "${mavenHome}/bin/mvn clean deploy"
 }
  stage('Deploy to Tomcat') 
    {
      
      sh """

      curl -u admin:admin123 \
     --upload-file /var/lib/jenkins/workspace/scripted-way-PL/target/maven-web-application.war \
     "http://15.207.71.1:8080//manager/text/deploy?path=/maven-web-application&update=true"
         """
    }
}
